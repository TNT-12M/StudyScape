# ============================================
# StudyScape 分布式架构配置 (server.env.example)
# ============================================
# ★ 复制为 server.env 后填入真实值 — 此文件不进 git (见 .gitignore)
# ★ 与 AccessKey.env / smtp.env 格式一致: KEY=VALUE
# ★ 优先级: 进程环境变量 > server.env > 默认值
#
# 用法:
#   cp server.env.example server.env  ← 部署时生成真实配置
#   # 修改后: PHP 自动读取, Python 自动读取
# ============================================


# ---------- 公网机题库 DB (questions.db) ----------
# SQLite ATTACH 双库架构: exam.db (热数据) + questions.db (冷数据)
# 公网机本地的 questions.db 副本 (定期从家里云 rsync 拉取)
QUESTIONS_DB_PATH=/data/StudyScape/questions.db


# ---------- 家里云 SSH (公网机 rsync 题库用) ----------
# 家里云本地的 questions.db 路径
HOME_SSH_HOST=120.79.161.207
HOME_SSH_PORT=2222
HOME_SSH_USER=lian
HOME_QUESTIONS_DB=/data/StudyScape/questions.db


# ---------- OCR Bridge 分布式通信 ----------
# ===== Bridge Server (公网机运行) =====
# 监听地址和端口, 家里云 Worker WebSocket 连接进来
BRIDGE_LISTEN_HOST=0.0.0.0
BRIDGE_LISTEN_PORT=1200
# PHP 本地 HTTP 接口 (仅 localhost 安全, 不暴露公网)
PHP_BRIDGE_HTTP_PORT=1201

# ===== Bridge Client (家里云运行) =====
# 家里云 OCR Worker 主动连接 Bridge Server
# 如果走 frp 穿透: 填 frps 公网端口
BRIDGE_REMOTE_HOST=127.0.0.1
BRIDGE_REMOTE_PORT=1200


# ---------- frp 内网穿透 (公网机做 frps 时) ----------
FRPS_BIND_PORT=7000
FRPS_TOKEN=replace_with_your_frps_token_here


# ---------- 家里云存储根 ----------
# bridge_client.py 用, 指向 /data 盘
# 如果不填: 自动探测 /data/StudyScape → fallback 项目内 data/
# STUDYSCAPE_STORAGE_ROOT=/data/StudyScape
