# ============================================
# StudyScape 分布式架构配置 (server.env.example)
# ============================================
# ★ 复制为 server.env 后填入真实值 — 此文件不进 git (见 .gitignore)
# ★ 与 AccessKey.env / smtp.env 格式一致: KEY=VALUE
# ★ 优先级: 进程环境变量 > server.env > 默认值
#
# 用法:
#   cp server.env.example server.env  ← 部署时生成真实配置
#   # 修改后: PHP 自动读取, Python 自动读取
# ============================================


# ---------- 公网机题库 DB (questions.db) ----------
# SQLite ATTACH 双库架构: exam.db (热数据) + questions.db (冷数据)
# 公网机本地的 questions.db 副本 (定期从家里云 rsync 拉取)
QUESTIONS_DB_PATH=/data/StudyScape/questions.db


# ---------- 家里云 SSH (公网机 rsync 题库用) ----------
# 直接填家里云公网可达的 IP (或 frp 映射后地址)
HOME_SSH_HOST=127.0.0.1
HOME_SSH_PORT=22
HOME_SSH_USER=lian
HOME_QUESTIONS_DB=/data/StudyScape/questions.db


# ---------- OCR Bridge 分布式通信 ★原生 WebSocket 直连★ ----------
# bridge_client.py 是自实现原生 WebSocket (asyncio 零依赖),
# 家里云 Worker 主动 TCP 连接公网机 IP:端口 → WebSocket 握手 → 长连接
# 不需要 frp / tailscale / zerotier 等任何内网穿透!
# 唯一要求: 公网机安全组放行 BRIDGE_LISTEN_PORT

# ===== Bridge Server (公网机运行) =====
BRIDGE_LISTEN_HOST=0.0.0.0   # 0.0.0.0 = 监听所有网卡, 公网直连
BRIDGE_LISTEN_PORT=1200      # 安全组必须放行此端口
PHP_BRIDGE_HTTP_PORT=1201    # PHP 本地接口 (仅 localhost, 不暴露公网)

# ===== Bridge Client (家里云运行) =====
# 直接填公网机真实 IP — 原生 TCP + WebSocket 直连, 无需 frp!
BRIDGE_REMOTE_HOST=1.2.3.4   # ← 新公网机的公网 IP
BRIDGE_REMOTE_PORT=1200


# ---------- 家里云存储根 ----------
# bridge_client.py 用, 指向 /data 盘
# 不填: 自动探测 /data/StudyScape → fallback 项目内 data/
# STUDYSCAPE_STORAGE_ROOT=/data/StudyScape
